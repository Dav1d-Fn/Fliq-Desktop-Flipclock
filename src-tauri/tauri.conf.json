{
  "productName": "Fliq - Clock",
  "version": "1.3.0",
  "identifier": "com.flipclock.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "decorations": false,
        "visible": false,
        "transparent": true,
        "shadow": false,
        "title": "Fliq - Clock",
        "maximizable": false,
        "resizable": false,
        "alwaysOnTop": true,
        "width": 300,
        "height": 150
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libgtk-layer-shell0"]
      },
      "rpm": {
        "depends": ["gtk-layer-shell"]
      }
    },
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
